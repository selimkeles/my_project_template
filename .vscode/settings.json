{
    // ── Editor ──────────────────────────────────────────────────────────
    "editor.fontLigatures": true,
    "editor.minimap.enabled": false,
    "editor.tabSize": 4,
    "diffEditor.ignoreTrimWhitespace": false,
    // ── Terminal ────────────────────────────────────
    "terminal.integrated.enablePersistentSessions": false,
    // ── Git ─────────────────────────────────────────────────────────────
    "git.allowNoVerifyCommit": true,
    "git.allowForcePush": true,
    "git.confirmSync": false,
    "git.blame.editorDecoration.enabled": true,
    "git.blame.statusBarItem.enabled": true,
    // ── Language-Specific Overrides ─────────────────────────────────────
    "[c]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[cpp]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.wordBasedSuggestions": "off",
        "editor.semanticHighlighting.enabled": true,
        "editor.stickyScroll.defaultModel": "outlineModel",
        "editor.suggest.insertMode": "replace"
    },
    // -------------------------------------------------------------------------
    // clangd — IntelliSense, code completion, diagnostics, formatting
    // -------------------------------------------------------------------------
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--completion-style=detailed",
        "--header-insertion=iwyu",
        "--log=error"
    ],
    // -------------------------------------------------------------------------
    // clangd + Bear
    // -------------------------------------------------------------------------
    // clangd reads compile_commands.json from the workspace root. Generate it
    // with `make bear` (or `bear -- make`) whenever sources or flags change.
    // -------------------------------------------------------------------------
    // C/C++ Extension (cpptools)
    // -------------------------------------------------------------------------
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.formatting": "disabled",
}