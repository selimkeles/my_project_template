{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // Four configurations, but each OS only ever shows its own pair:
    //
    //   Linux / macOS   Debug (gdb)    cppdbg  (GDB/MI)
    //   Windows         Debug (MSVC)   cppvsdbg (Visual Studio debugger)
    //
    // How the hiding works: a "windows" / "linux" / "osx" section is merged over
    // the configuration before the dropdown is built, and VSCode drops every
    // entry whose presentation.hidden is true. VSCode also does NOT filter the
    // members of a compound by OS (it starts every one it is given), which is
    // why there are no "compounds" here - one compound cannot serve both
    // platforms, and hiding does the job on its own.
    //
    // The names must stay unique: launch.json is looked up with find(), so two
    // configurations sharing a name would always resolve to the first one.
    //
    // "type" cannot live in an OS section (it picks the debug adapter), hence
    // one configuration per debugger instead of one per target.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/TemplateProject",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "presentation": {
                "group": "1-run",
                "order": 1
            },
            "windows": {
                "presentation": {
                    "hidden": true
                }
            }
        },
        {
            "name": "Debug (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/TemplateProject.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "build",
            "presentation": {
                "group": "1-run",
                "order": 1
            },
            "linux": {
                "presentation": {
                    "hidden": true
                }
            },
            "osx": {
                "presentation": {
                    "hidden": true
                }
            }
        },
        {
            "name": "Test (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/test_TemplateProject",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build-test",
            "presentation": {
                "group": "2-test",
                "order": 1
            },
            "windows": {
                "presentation": {
                    "hidden": true
                }
            }
        },
        {
            "name": "Test (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/test_TemplateProject.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "build-test",
            "presentation": {
                "group": "2-test",
                "order": 1
            },
            "linux": {
                "presentation": {
                    "hidden": true
                }
            },
            "osx": {
                "presentation": {
                    "hidden": true
                }
            }
        }
    ]
}
